# 前端多阶段构建：Node 产出 dist -> nginx:alpine 托管静态 SPA
# build context 是「项目根」（见 deploy/docker-compose.yml 的 build.context: ../..），
# 所有 COPY 源路径从项目根开始写。

FROM node:20-alpine AS build
WORKDIR /build
# 先只复制清单文件，利用 Docker 层缓存：依赖不变时 npm ci 不会重跑
COPY front-end/package*.json /build/
RUN npm ci
COPY front-end/ /build/
RUN npm run build

FROM nginx:alpine
COPY --from=build /build/dist/ /usr/share/nginx/html/
COPY back-end-spring-cloud/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
