# 拾光记 · 环境变量样例
# 用法：复制为 .env（已被 .gitignore 排除）或直接注入到运行/部署环境。
# 切勿把真实密码、JWT 密钥提交到仓库。带 (可选) 的项有默认值，可省略。

# --- 运行 ---
COT_PROFILE=mysql
COT_SERVER_PORT=8080

# --- 数据库（MySQL 8）---
COT_DB_URL=jdbc:mysql://localhost:3306/chronicles_of_time?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&allowMultiQueries=true&createDatabaseIfNotExist=true
COT_DB_USER=root
COT_DB_PASSWORD=change-me
COT_DB_POOL_SIZE=20          # 可选，仅 prod profile 生效
COT_DB_MIN_IDLE=5            # 可选，仅 prod profile 生效

# --- 鉴权（生产必须替换；prod profile 下缺失会启动失败）---
COT_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
COT_AUTH_TTL_HOURS=12        # 可选

# --- Redis（业务链路当前未使用，仅预留）---
COT_REDIS_HOST=localhost
COT_REDIS_PORT=6379
COT_REDIS_PASSWORD=
COT_HEALTH_REDIS_ENABLED=false

# --- 存储 / 日志 ---
COT_UPLOAD_DIR=./uploads
COT_LOG_FILE=./logs/cot.log  # 可选，仅 prod profile 生效

# --- 容器部署（docker compose 读取，非应用内部变量）---
MYSQL_ROOT_PASSWORD=change-me
COT_WEB_PORT=5173

# 前端开发：若后端改用非 8080 端口，需同步修改 front-end/vite.config.js
# 中 /api 与 /files 两处 proxy target。
